# Copy to .env for local development (never commit .env).
PROJECT_NAME=event-ingest-service
DEBUG=true

# SQLAlchemy async URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/event_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_CHANNEL=events:stream

# JWT — generate a long random value for anything beyond local learning
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# asyncpg / SQLAlchemy pool
POOL_SIZE=20
MAX_OVERFLOW=10

# Optional: create a default admin on startup (local only)
SEED_ADMIN=true
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=adminadmin
